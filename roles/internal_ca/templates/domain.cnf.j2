[req]
default_bits = {{ internal_ca_key_size }}
prompt = no
default_md = sha256
distinguished_name = dn
req_extensions = req_ext

[dn]
C={{ internal_ca_country }}
ST={{ internal_ca_state }}
L={{ internal_ca_locality }}
O={{ internal_ca_organization }}
CN={{ domain.common_name | default(domain.name) }}

[req_ext]
subjectAltName = @alt_names

[v3_req]
basicConstraints = critical, CA:FALSE
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid, issuer
subjectAltName = @alt_names

[alt_names]
{% if domain.san is defined %}
{% for san in domain.san %}
DNS.{{ loop.index }} = {{ san }}
{% endfor %}
{% else %}
DNS.1 = {{ domain.name }}
{% endif %}
