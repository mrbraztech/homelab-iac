# {{ ansible_managed }}
# Unbound recursive DNS resolver for Pi-hole
# https://docs.pi-hole.net/guides/unbound/

server:
    verbosity: 0
    interface: {{ unbound_listen_address }}
    port: {{ unbound_listen_port }}
    do-ip4: yes
    do-ip6: no
    do-udp: yes
    do-tcp: yes

    # Privacy
    hide-identity: yes
    hide-version: yes

    # DNSSEC (trust anchor defined in root-auto-trust-anchor-file.conf)
    val-clean-additional: yes

    # Performance
    num-threads: 2
    msg-cache-size: 128m
    rrset-cache-size: 256m
    cache-min-ttl: 3600
    cache-max-ttl: 86400
    infra-cache-slabs: 4
    msg-cache-slabs: 4
    rrset-cache-slabs: 4

    # Prefetch and serve expired
    prefetch: yes
    prefetch-key: yes
    serve-expired: yes
    serve-expired-ttl: 86400

    # Security
    harden-glue: yes
    harden-dnssec-stripped: yes
    harden-referral-path: yes
    harden-algo-downgrade: yes
    use-caps-for-id: yes
    edns-buffer-size: 1232
    qname-minimisation: yes
    aggressive-nsec: yes
    rrset-roundrobin: yes
    minimal-responses: yes

    # Root hints
    root-hints: /var/lib/unbound/root.hints

    # Deny non-local
    do-not-query-localhost: no

    # Logging
    val-log-level: 1

    private-address: 192.168.0.0/16
    private-address: 10.0.0.0/8
    private-address: 172.16.0.0/12
    private-address: 169.254.0.0/16
    private-address: fd00::/8
    private-address: fe80::/10
