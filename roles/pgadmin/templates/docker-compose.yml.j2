services:
  pgadmin:
    image: "{{ pgadmin_image }}"
    container_name: "{{ pgadmin_container_name }}"
    restart: unless-stopped
    environment:
      PGADMIN_DEFAULT_EMAIL: "{{ pgadmin_email }}"
      PGADMIN_DEFAULT_PASSWORD: "{{ pgadmin_password }}"
    ports:
      - "{{ pgadmin_http_port }}:80"
    volumes:
      - ./pgadmin:/var/lib/pgadmin
