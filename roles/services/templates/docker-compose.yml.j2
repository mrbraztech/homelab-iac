services:
  postgres:
    image: "{{ services_postgres_image }}"
    container_name: "{{ services_postgres_container_name }}"
    restart: unless-stopped
    environment:
      POSTGRES_PASSWORD: "{{ services_postgres_password }}"
      POSTGRES_DB: "{{ services_postgres_databases[0] }}"
    ports:
      - "{{ services_postgres_port }}:5432"
    volumes:
      - {{ services_postgres_volume_path }}:/var/lib/postgresql/data

  redis:
    image: "{{ services_redis_image }}"
    container_name: "{{ services_redis_container_name }}"
    restart: unless-stopped
    ports:
      - "{{ services_redis_port }}:6379"
