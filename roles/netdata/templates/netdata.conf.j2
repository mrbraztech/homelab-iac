# netdata configuration
# Managed by Ansible - do not edit manually

[global]
    memory mode = {{ netdata_memory_mode }}
{% if netdata_memory_mode == 'dbengine' %}
    dbengine page cache size MiB = {{ netdata_dbengine_page_cache_size_mib }}
    dbengine tier 0 disk space MiB = {{ netdata_dbengine_tier0_disk_space_mib }}
    dbengine tier 1 disk space MiB = {{ netdata_dbengine_tier1_disk_space_mib }}
    dbengine tier 2 disk space MiB = {{ netdata_dbengine_tier2_disk_space_mib }}
{% endif %}
