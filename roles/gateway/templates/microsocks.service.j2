[Unit]
Description=MicroSocks SOCKS5 proxy
After=network.target

[Service]
Type=simple
{% if gateway_socks_auth %}
ExecStart=/usr/bin/microsocks -i {{ gateway_socks_bind }} -p {{ gateway_socks_port }} -u {{ gateway_socks_user }} -P {{ gateway_socks_password }}
{% else %}
ExecStart=/usr/bin/microsocks -i {{ gateway_socks_bind }} -p {{ gateway_socks_port }}
{% endif %}
Restart=on-failure
RestartSec=5
DynamicUser=true
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
