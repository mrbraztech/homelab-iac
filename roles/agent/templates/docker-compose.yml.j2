services:
  hermes:
    image: "{{ agent_image }}"
    container_name: "{{ agent_container_name }}"
    restart: unless-stopped
    command: gateway run
    environment:
      HERMES_HOME: /opt/data
{% if agent_dashboard_enabled %}
      HERMES_DASHBOARD: "true"
      HERMES_DASHBOARD_HOST: "{{ agent_dashboard_host }}"
      HERMES_DASHBOARD_PORT: "{{ agent_dashboard_port }}"
      HERMES_DASHBOARD_BASIC_AUTH_USERNAME: "{{ agent_dashboard_basic_auth_username }}"
      HERMES_DASHBOARD_BASIC_AUTH_PASSWORD: "{{ agent_dashboard_basic_auth_password }}"
{% endif %}
{% if agent_api_server_enabled %}
      API_SERVER_ENABLED: "true"
      API_SERVER_HOST: "{{ agent_api_server_host }}"
      API_SERVER_KEY: "{{ agent_api_server_key }}"
{% endif %}
    ports:
      - "{{ agent_dashboard_port }}:{{ agent_dashboard_port }}"
{% if agent_api_server_enabled %}
      - "{{ agent_api_server_port }}:{{ agent_api_server_port }}"
{% endif %}
    volumes:
      - ./data:/opt/data
    deploy:
      resources:
        limits:
          memory: "{{ agent_memory_limit }}"
          cpus: "{{ agent_cpus_limit }}"
