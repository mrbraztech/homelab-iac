services:
  frigate:
    image: "{{ frigate_image }}"
    container_name: "{{ frigate_container_name }}"
    restart: unless-stopped
    network_mode: host
    privileged: true
    shm_size: "256mb"
    volumes:
      - {{ frigate_config_path }}:/config
      - {{ frigate_data_path }}:/media/frigate
      - type: tmpfs
        target: /tmp/cache
        tmpfs:
          size: 1073741824
