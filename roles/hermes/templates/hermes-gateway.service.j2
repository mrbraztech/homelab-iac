[Unit]
Description=Hermes Agent Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ hermes_user }}
Group={{ hermes_group }}
WorkingDirectory=/home/{{ hermes_user }}
Environment="PATH=/home/{{ hermes_user }}/.hermes/bin:/usr/local/bin:/usr/bin:/bin"
Environment="HOME=/home/{{ hermes_user }}"
ExecStart=/home/{{ hermes_user }}/.hermes/bin/hermes gateway start
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
