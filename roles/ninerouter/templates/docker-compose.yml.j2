---
services:
  9router:
    image: {{ ninerouter_image }}
    container_name: {{ ninerouter_container_name }}
    restart: unless-stopped
    ports:
      - "{{ ninerouter_port }}:20128"
    volumes:
      - {{ ninerouter_data_path }}:/app/data
    environment:
      DATA_DIR: /app/data
      PORT: "20128"
      HOSTNAME: "0.0.0.0"
      NODE_ENV: production
      HEADROOM_URL: http://headroom:8787
      JWT_SECRET: {{ ninerouter_jwt_secret }}
      INITIAL_PASSWORD: {{ ninerouter_initial_password }}
      REQUIRE_API_KEY: "false"
    depends_on:
      - headroom

  headroom:
    image: {{ ninerouter_headroom_image }}
    container_name: {{ ninerouter_headroom_container_name }}
    restart: unless-stopped
    ports:
      - "{{ ninerouter_headroom_port }}:8787"
